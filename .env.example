# Optional: Resend API key for the contact form (https://resend.com).
# Without it the form shows an error with a mailto: link instead of sending.
RESEND_API_KEY=

# Optional: WebSocket server for live cursors, chat, presence and the game.
# The original backend is closed-source, so leave this empty; those features
# then stay hidden.
NEXT_PUBLIC_WS_URL=

# Optional: your own Umami analytics. The script loads only when BOTH are set.
# UMAMI_DOMAIN is the full script URL, e.g. https://cloud.umami.is/script.js
UMAMI_DOMAIN=
UMAMI_SITE_ID=
